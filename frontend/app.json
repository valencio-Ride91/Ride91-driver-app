{
  "expo": {
    "name": "Ride91 Driver",
    "slug": "ride91-driver",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ride91",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.emergent.fleetmobile.uefjzz",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Track your duty location for the fleet.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Track duty location in background."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#10231C"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.fleetmobile.uefjzz",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "REPLACE_WITH_GOOGLE_MAPS_API_KEY"
        }
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Track your duty location for the fleet."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#10231C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
